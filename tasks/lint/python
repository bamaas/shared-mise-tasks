#!/usr/bin/env bash
#MISE description="Lint Python code with ruff"
set -euo pipefail

SHARED="$(cd "$(dirname "$0")/../.." && pwd)"

# Tool resolution: PATH wins, otherwise shared stub
if command -v ruff &>/dev/null; then
    RUFF="ruff"
else
    RUFF="$SHARED/bin/ruff"
fi

# Config resolution: local .lint/ruff.toml wins, otherwise shared default
if [ -f "$MISE_PROJECT_ROOT/.lint/ruff.toml" ]; then
    "$RUFF" check --config "$MISE_PROJECT_ROOT/.lint/ruff.toml" .
else
    "$RUFF" check --config "$SHARED/config/ruff.toml" .
fi
